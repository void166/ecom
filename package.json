{
  "name": "commerce-platform",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @commerce/api --filter @commerce/storefront --filter @commerce/backoffice dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @commerce/api prisma:generate",
    "db:migrate": "pnpm --filter @commerce/api prisma:migrate",
    "db:seed": "pnpm --filter @commerce/api prisma:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.25.0",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.31.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
